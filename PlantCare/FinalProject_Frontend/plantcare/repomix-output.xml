import 'package:flutter/material.dart';
// Veritabanı helper dosyanızın yolunu buraya ekleyin
// import 'database_helper.dart'; 

class ChatbotScreen extends StatefulWidget {
  @override
  _ChatbotScreenState createState() => _ChatbotScreenState();
}

class _ChatbotScreenState extends State<ChatbotScreen> {
  final TextEditingController _controller = TextEditingController();
  List<Map<String, dynamic>> _messages = [];

  // Mesaj gönderim ve veritabanına kayıt mantığı
  void _sendMessage(String text) async {
    if (text.isEmpty) return;

    setState(() {
      _messages.add({'text': text, 'isUser': 1}); // 1 = Kullanıcı
    });
    _controller.clear();

    // TODO: Burada DatabaseHelper.instance.insertMessage(...) çağrılacak
    // TODO: Burada apiService.sendMessage(text) ile Flask'tan yanıt alınacak

    // Simülasyon: Botun cevabı
    await Future.delayed(Duration(milliseconds: 800));
    setState(() {
      _messages.add({'text': "Bitkiniz için sulama zamanı yaklaştı!", 'isUser': 0});
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text("Plant AI Assistant")),
      body: Column(
        children: [
          Expanded(
            child: ListView.builder(
              padding: EdgeInsets.all(10),
              itemCount: _messages.length,
              itemBuilder: (ctx, i) {
                bool isUser = _messages[i]['isUser'] == 1;
                return Align(
                  alignment: isUser ? Alignment.centerRight : Alignment.centerLeft,
                  child: Container(
                    padding: EdgeInsets.symmetric(horizontal: 15, vertical: 10),
                    margin: EdgeInsets.symmetric(vertical: 5),
                    decoration: BoxDecoration(
                      color: isUser ? Color(0xFF2D5A27) : Colors.grey[200],
                      borderRadius: BorderRadius.circular(15),
                    ),
                    child: Text(
                      _messages[i]['text'],
                      style: TextStyle(color: isUser ? Colors.white : Colors.black),
                    ),
                  ),
                );
              },
            ),
          ),
          Padding(
            padding: const EdgeInsets.all(8.0),
            child: Row(
              children: [
                Expanded(child: TextField(controller: _controller, decoration: InputDecoration(hintText: "Bitkiniz hakkında sorun..."))),
                IconButton(icon: Icon(Icons.send, color: Color(0xFF2D5A27)), onPressed: () => _sendMessage(_controller.text)),
              ],
            ),
          ),
        ],
      ),
    );
  }
}
