                                 .include "functions.asm"
0000a2 9508                      
                                 conv_hextodec: ; SUBROUTINE OF CONVERSION
0000a3 e207                      	ldi r16, HIGH(10000) ; SET THE DECIMAL DIVIDER TO 10.000 DECIMAL
0000a4 2e40                      	mov r4, r16
0000a5 e100                      	ldi r16, LOW(10000)
0000a6 2e30                      	mov r3, r16
0000a7 d014                      	rcall DEC_DIG ; GET DIGIT BY REPETEAD SUBTRACTION
0000a8 2e90                      	mov r9, r16 ; SET TEN THOUNSANDS DIGIT
0000a9 e003                      	ldi r16, HIGH(1000) ; SET THE DECIMAL DIVIDER TO 1.000 DECIMAL
0000aa 2e40                      	mov r4, r16
0000ab ee08                      	ldi r16, LOW(1000)
0000ac 2e30                      	mov r3, r16
0000ad d00e                      	rcall DEC_DIG ; GET DIGIT BY REPETEAD SUBTRACTION
0000ae 2e80                      	mov r8, r16 ; SET THOUNSANDS DIGIT
0000af 2444                      	clr r4 ; SET THE DECIMAL DIVIDER TO 100 DECIMAL
0000b0 e604                      	ldi r16, 100
0000b1 2e30                      	mov r3, r16
0000b2 d009                      	rcall DEC_DIG ; GET DIGIT BY REPETEAD SUBTRACTION
0000b3 2e70                      	mov r7, r16 ; SET HUNDREDS DIGIT
0000b4 e00a                      	ldi r16, 10 ; SET THE DECIMAL DIVIDER TO 10 DECIMAL
0000b5 2e30                      	mov r3, r16
0000b6 d005                      	rcall DEC_DIG ; GET DIGIT BY REPETEAD SUBTRACTION
0000b7 2e60                      	mov r6, r16 ; SET TENS DIGIT
0000b8 e000                      	ldi r16, 0
0000b9 0d01                      	add r16, R1
0000ba 2e50                      	mov r5, r16 ; SET ONES DIGIT
0000bb 9508                      	ret
                                 DEC_DIG:
0000bc e000                      	ldi r16, 0 ; START WITH DECIMAL VALUE 0
                                 DEC_DIG1:
0000bd 1413                      	cp r1, r3 ; COMPARE WORD WITH DECIMAL DIVIDER VALUE
0000be 0424                      	cpc r2, r4
0000bf f408                      	brcc DEC_DIG2 ; IF CARRY CLEAR, SUBTRACT DIVIDER VALUE
0000c0 9508                      	ret ; DONE SUBTRACTION
                                 DEC_DIG2:
0000c1 1813                      	sub r1, r3 ; SUBTRACT DIVIDER VALUE
0000c2 0824                      	sbc r2, r4
0000c3 9503                      	inc r16 ; UP ONE DIGIT
0000c4 cff8                      	rjmp DEC_DIG1 ; ONCE AGAIN
                                 
                                 step_count:
                                 	; R15 = High Byte, R14 = Low Byte
0000c5 94e3                          inc r14			             
0000c6 f409                          brne check_limit    
0000c7 94f3                          inc r15             
                                 
                                 check_limit:
                                     ; check if r15:r14 == 1000 (0x03E8)
                                     
0000c8 2d0f                      	mov r16, r15
0000c9 3003                          cpi r16, high(0x03E8)
0000ca f429                          brne exit_step     
                                     
0000cb 2d0e                      	mov r16, r14
0000cc 3e08                          cpi r16, low(0x03E8)
0000cd f411                          brne exit_step      
                                 
                                     ; reset to 0 if r15:r14 >= 1000
0000ce 24ee                          clr r14
0000cf 24ff                          clr r15
                                 
                                 exit_step:
0000d0 9508                          ret
                                 
                                 EEPROM_read:
0000d1 99e1                      	sbic EECR,EEWE ; Wait for completion of previous write
0000d2 cffe                      	rjmp EEPROM_read
0000d3 bb2f                      	out EEARH, r18 ; Set up address (r18:r17) in address register
0000d4 bb1e                      	out EEARL, r17
0000d5 9ae0                      	sbi EECR,EERE ; Start eeprom read by writing EERE
0000d6 b30d                      	in r16,EEDR ; Read data from data register
0000d7 9508                      ret
                                 
                                 EEPROM_write:
0000d8 99e1                      	sbic EECR, EEWE
0000d9 cffe                      	rjmp EEPROM_write ; Wait for completion of previous write
0000da bb2f                      	out EEARH, r18 ; Set up address (r18:r17) in address register
0000db bb1e                      	out EEARL, r17
0000dc bb0d                      	out EEDR, r16 ; Write data (r16) to data register
0000dd 9ae2                      	sbi EECR, EEMWE ; Write logical one to EEMWE
0000de 9ae1                      	sbi EECR, EEWE ; Start eeprom write by setting EEWE
0000df 9508                      
