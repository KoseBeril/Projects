                                 display: 
                                    
00000a d022                          rcall reset_digits
00000b 2d05                          mov  r16, r5
00000c d00b                          rcall digit
00000d 9a93                          sbi  PORTD, PD3
                                  
00000e d01e                          rcall reset_digits
00000f 2d06                          mov  r16, r6
000010 d007                          rcall digit
000011 9a91                          sbi  PORTD, PD1
                                 
000012 d01a                          rcall reset_digits
000013 2d07                          mov  r16, r7
000014 d003                          rcall digit
000015 9a90                          sbi  PORTD, PD0
                                 
000016 d016                          rcall reset_digits
000017 9508                          ret
                                 
                                 
                                 digit:  
000018 3000                       cpi r16, 0 
000019 f0b9                       breq label_zero 
                                 
00001a 3001                       cpi r16, 1
00001b f0b9                       breq label_one
                                 
00001c 3002                       cpi r16, 2 
00001d f0b9                       breq label_two 
                                 
00001e 3003                       cpi r16, 3
00001f f0b9                       breq label_three
                                   
000020 3004                       cpi r16, 4
000021 f0b9                       breq label_four
                                 
000022 3005                       cpi r16, 5
000023 f0b9                       breq label_five
                                 
000024 3006                       cpi r16, 6 
000025 f0b9                       breq label_six
                                   
000026 3007                       cpi r16, 7
000027 f0b9                       breq label_seven
                                 
000028 3008                       cpi r16, 8
000029 f0b9                       breq label_eight
                                  
00002a 3009                       cpi r16, 9 
00002b f0b9                       breq label_nine 
00002c 9508                      ret 
                                  
                                 reset_digits: 
00002d 9893                       cbi portd, pd3; digit1 cathode 
00002e 9891                       cbi portd, pd1; digit2 cathode 
00002f 9890                       cbi portd, pd0; digit3 cathode 
000030 9508                      ret 
                                  
                                 label_zero: 
000031 d013                       rcall zero 
000032 9508                      ret 
                                  
                                 label_one: 
000033 d019                       rcall one 
000034 9508                      ret 
                                 
                                 label_two: 
000035 d01f                        rcall two 
000036 9508                       ret 
                                  
                                  label_three: 
000037 d025                       rcall three 
000038 9508                       ret 
                                 
                                  label_four: 
000039 d02b                       rcall four 
00003a 9508                       ret 
                                 
                                  label_five: 
00003b d031                       rcall five 
00003c 9508                       ret
                                  
                                  label_six: 
00003d d037                       rcall six 
00003e 9508                       ret  
                                 
                                  label_seven: 
00003f d03d                       rcall seven
000040 9508                       ret 
                                 
                                  label_eight: 
000041 d043                       rcall eight
000042 9508                       ret 
                                  
                                 label_nine: 
000043 d049                       rcall nine 
000044 9508                       ret 
                                  
