                                  EEPROM_read:
000095 99e1                      	sbic EECR,EEWE ; Wait for completion of previous write 
000096 cffe                      	rjmp EEPROM_read ; Set up address (r18:r17) in address register 
000097 bb2f                      	out EEARH, r18 
000098 bb1e                      	out EEARL, r17 
000099 9ae0                      	sbi EECR,EERE ; Start eeprom read by writing EERE
00009a b33d                      	in r19,EEDR  ; Read data from data register 
00009b 9508                      ret 
                                 
                                 EEPROM_write: 
00009c 99e1                      	sbic EECR, EEWE  
00009d cffe                      	rjmp EEPROM_write ; Wait for completion of previous write 
00009e bb2f                      	out EEARH, r18 ; Set up address (r18:r17) in address register 
00009f bb1e                      	out EEARL, r17  
0000a0 bb3d                      	out EEDR, r19 ; Write data (r16) to data register 
0000a1 9ae2                      	sbi EECR, EEMWE ; Write logical one to EEMWE 
0000a2 9ae1                      	sbi EECR, EEWE ; Start eeprom write by setting EEWE 
0000a3 9508                      ret 
                                 
                                 
                                  conv_hextodec:   ; SUBROUTINE OF CONVERSION 
0000a4 e207                       ldi   r16,  HIGH(10000)   ; SET THE DECIMAL DIVIDER TO 10.000 DECIMAL  
0000a5 2e40                       mov   r4,  r16 
0000a6 e100                       ldi   r16,  LOW(10000)  
0000a7 2e30                       mov   r3,  r16 
0000a8 d014                       rcall DEC_DIG   ; GET DIGIT BY REPETEAD SUBTRACTION  
0000a9 2e90                       mov   r9,  r16  ; SET TEN THOUNSANDS DIGIT 
                                  
0000aa e003                       ldi   r16,  HIGH(1000) ; SET THE DECIMAL DIVIDER TO 1.000 DECIMAL  
0000ab 2e40                       mov   r4,  r16 
0000ac ee08                       ldi   r16,  LOW(1000)  
0000ad 2e30                       mov   r3,  r16 
0000ae d00e                       rcall DEC_DIG   ; GET DIGIT BY REPETEAD SUBTRACTION 
0000af 2e80                       mov   r8,  r16  ; SET THOUNSANDS DIGIT 
                                  
0000b0 2444                       clr   r4   ; SET THE DECIMAL DIVIDER TO 100 DECIMAL  
0000b1 e604                       ldi   r16,  100 
0000b2 2e30                       mov   r3,  r16 
0000b3 d009                       rcall DEC_DIG   ; GET DIGIT BY REPETEAD SUBTRACTION 
0000b4 2e70                       mov   r7,  r16  ; SET HUNDREDS DIGIT 
                                  
0000b5 e00a                       ldi   r16,  10  ; SET THE DECIMAL DIVIDER TO 10 DECIMAL  
0000b6 2e30                       mov   r3,  r16 
0000b7 d005                       rcall DEC_DIG   ; GET DIGIT BY REPETEAD SUBTRACTION 
0000b8 2e60                       mov   r6,  r16  ; SET TENS DIGIT 
                                  
0000b9 e000                       ldi  r16, 0 
0000ba 0d02                       add  r16, r2 
0000bb 2e50                       mov  r5,  r16   ; SET ONES DIGIT  
0000bc 9508                       ret 
                                  
                                 DEC_DIG: 
0000bd e000                       ldi  r16,  0   ; START WITH DECIMAL VALUE 0  
                                 DEC_DIG1: 
0000be 1423                       cp    r2,  r3   ; COMPARE WORD WITH DECIMAL DIVIDER VALUE  
0000bf 0414                       cpc   r1,  r4 
0000c0 f408                       brcc  DEC_DIG2  ; IF CARRY CLEAR, SUBTRACT DIVIDER VALUE  
0000c1 9508                       ret    ; DONE SUBTRACTION 
                                 DEC_DIG2: 
0000c2 1823                       sub   r2,  r3   ; SUBTRACT DIVIDER VALUE  
0000c3 0814                       sbc   r1,  r4 
0000c4 9503                       inc   r16   ; UP ONE DIGIT 
0000c5 cff8                      rjmp  DEC_DIG1  ; ONCE AGAIN 
                                 	
                                 
                                 
                                 step_count:
                                     ; (r15:r14) = (current value)
                                 
                                     ; 16-bit increment
0000c6 e001                          ldi  r16, 1
0000c7 0ee0                          add  r14, r16
0000c8 2700                          clr  r16
0000c9 1ef0                          adc  r15, r16
                                 
                                     ; Compare with 1000 (0x03E8)
0000ca ee08                          ldi  r16, low(1000)   ; 0xE8
0000cb e013                          ldi  r17, high(1000)  ; 0x03
0000cc 16e0                          cp   r14, r16
0000cd 06f1                          cpc  r15, r17
                                 
0000ce f018                          brlo step_done        ; current < 1000 ? çýk
0000cf f011                          breq step_done        ; current == 1000 ? çýk
                                 
                                     ; current > 1000 ? wrap
0000d0 24ee                          clr r14
0000d1 24ff                          clr r15
                                 
                                 step_done:
0000d2 9508                          ret
                                 
